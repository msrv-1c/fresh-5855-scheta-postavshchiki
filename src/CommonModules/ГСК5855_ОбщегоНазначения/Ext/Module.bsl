#Область ПрограммныйИнтерфейс

Функция ТекстБрендинга() Экспорт
	Возврат НСтр("ru = 'Создано на Конвейере 1С — https://gitsell.ru/1c'");
КонецФункции

Функция URLКонвейера() Экспорт
	Возврат "https://gitsell.ru/1c";
КонецФункции

Функция ПоказыватьБрендинг() Экспорт
	Возврат Константы.ГСК5855_ПоказыватьБрендинг.Получить();
КонецФункции

Процедура ВключитьКолонкиОплатыВНастройках(КомпоновщикНастроек) Экспорт
	
	ИменаКолонок = ИменаКолонокОтчета();
	Настройки = КомпоновщикНастроек.Настройки;
	
	Для Каждого ИмяПоля Из ИменаКолонок Цикл
		Если Настройки.Выбор.ДоступныеПоляВыбора.НайтиПоле(Новый ПолеКомпоновкиДанных(ИмяПоля)) <> Неопределено
			И Не ПолеУжеВыбрано(Настройки.Выбор.Элементы, ИмяПоля) Тогда
			Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
			Поле.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолеУжеВыбрано(ЭлементыВыбора, ИмяПоля)
	
	Для Каждого ЭлементВыбора Из ЭлементыВыбора Цикл
		Если Строка(ЭлементВыбора.Поле) = ИмяПоля Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ИменаКолонокОтчета() Экспорт
	
	Колонки = Новый Массив;
	Колонки.Добавить("СуммаДокумента");
	Колонки.Добавить("СуммаОплаты");
	Колонки.Добавить("НеоплаченныйОстаток");
	Возврат Колонки;
	
КонецФункции

#КонецОбласти
